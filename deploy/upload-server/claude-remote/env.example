# Copy to .env next to compose.yaml. The folders are the server's own paths: they're mounted at the
# same path inside the container, so docker compose run from inside it finds the same folders.
# The upload server's folder (compose.yaml, .env, server.py):
LIVE_DIR=/srv/canopener-upload
# Auto-deploy's folder (auto-deploy.sh, requests/, deploy.log):
DEPLOY_DIR=/srv/canopener-deploy
# The group that owns /var/run/docker.sock (full mode only): stat -c %g /var/run/docker.sock
DOCKER_GID=999
# The machine's name in the Claude app's environment list (letters, digits, hyphens)
RC_HOSTNAME=claude-remote
# The session's name in the Claude app, and its permission mode (default: edits and commands ask first)
RC_NAME=upload server
RC_PERMISSION_MODE=default
