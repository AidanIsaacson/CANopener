# Copy to .env (next to compose.yaml) and fill in. Never commit .env.
# Make each token with:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"

# Tokens that may upload: one per unit (desktop laptop, handheld), so one can be revoked alone.
UPLOAD_TOKENS=
# Tokens that may list and download captures: yours, and one for an AI assistant's environment.
READ_TOKENS=
# Tokens that may delete a capture (DELETE /api/captures/<key>). Empty: nothing can.
ADMIN_TOKENS=
# Tokens that may use remote help: list the units calling in and send them commands
# (System > Remote help on a handheld; canopener-cli remote). Give one only to someone you'd hand
# the unit to. Empty: nobody can.
REMOTE_TOKENS=
# The public address (the Cloudflare tunnel's hostname), for the links the server hands back.
PUBLIC_URL=https://logs.example.com
SERVER_NAME=CANopener upload server

# Optional limits
# MAX_UPLOAD_MB=4096
# MAX_PART_MB=64
# KEEP_REVISIONS=3
# INCOMING_DAYS=7
# Delete captures this many days after their last upload (0 = keep for ever)
# KEEP_DAYS=0
# Seconds a connection may sit idle before the server drops it
# REQUEST_TIMEOUT=120
# The longest a remote-help session may be open, in minutes
# REMOTE_MAX_MINUTES=240
