[Unit]
Description=CAN Opener J1939 Diagnostic Tool
After=graphical-session.target
Wants=graphical-session.target

[Service]
Type=simple
User=pi
Environment=DISPLAY=:0
Environment=XAUTHORITY=/home/pi/.Xauthority
WorkingDirectory=/home/pi/can_opener
ExecStartPre=/bin/bash -c 'sudo ip link set can0 down 2>/dev/null; sudo ip link set can0 up type can bitrate 250000'
ExecStart=/usr/bin/python3 /home/pi/can_opener/main.py
Restart=on-failure
RestartSec=5
StandardOutput=append:/tmp/can_opener.log
StandardError=append:/tmp/can_opener.log

[Install]
WantedBy=graphical-session.target
