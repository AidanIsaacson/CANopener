# /etc/sudoers.d/can_opener
# Allows the pi user to bring CAN interfaces up/down without a password.
# Install with:
#   sudo cp can_sudoers /etc/sudoers.d/can_opener
#   sudo chmod 440 /etc/sudoers.d/can_opener

pi ALL=(ALL) NOPASSWD: /sbin/ip link set can0 up *
pi ALL=(ALL) NOPASSWD: /sbin/ip link set can0 down
pi ALL=(ALL) NOPASSWD: /sbin/ip link set can1 up *
pi ALL=(ALL) NOPASSWD: /sbin/ip link set can1 down
pi ALL=(ALL) NOPASSWD: /sbin/shutdown *
pi ALL=(ALL) NOPASSWD: /sbin/reboot
